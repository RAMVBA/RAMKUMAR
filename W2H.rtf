\par
def rgb_to_hex(rgb):\par
    if not rgb:\par
        return ""\par
    return "#\{:02X\}\{:02X\}\{:02X\}".format(rgb[0], rgb[1], rgb[2])\par
\par
def escape_html(text):\par
    replacements = \{\par
        "&": "&amp;", "<": "&lt;", ">": "&gt;",\par
        "\f2\bullet ": "&bull;", "\endash ": "&ndash;", "\emdash ": "&mdash;",\par
        "\f0\'a7": "&sect;", "\'a9": "&copy;", "\'ae": "&reg;",\par
        "\'e1": "&aacute;", "\'e0": "&agrave;", "\'e4": "&auml;",\par
        "\'e9": "&eacute;", "\'e8": "&egrave;", "\'eb": "&euml;",\par
        "\'ed": "&iacute;", "\'ec": "&igrave;", "\'ef": "&iuml;",\par
        "\'f3": "&oacute;", "\'f2": "&ograve;", "\'f6": "&ouml;",\par
        "\'fa": "&uacute;", "\'f9": "&ugrave;", "\'fc": "&uuml;",\par
        "\'f1": "&ntilde;", "\'e7": "&ccedil;",\par
        "\f6\u339?": "&oelig;", "\u338?": "&OElig;",\par
        "\f0\'df": "&szlig;"\par
    \}\par
    for k, v in replacements.items():\par
        text = text.replace(k, v)\par
    return text\par
\par
def wingdings_mapper(char_code):\par
    mapping = \{\par
        252: "&check;",\par
        168: "&bull;",\par
        251: "&ucirc;"\par
    \}\par
    return mapping.get(char_code, "")\par
\par
def paragraph_alignment(p):\par
    return \{\par
        0: "left",\par
        1: "center",\par
        2: "right",\par
        3: "justify"\par
    \}.get(p.alignment, "left")\par
\par
# =====================================================\par
# PARAGRAPH CONVERSION\par
# =====================================================\par
\par
def convert_paragraph(para):\par
    html = ""\par
    for run in para.runs:\par
        if not run.text.strip():\par
            continue\par
\par
        txt = escape_html(run.text)\par
        font = run.font\par
\par
        # Wingdings\par
        if font.name and ("Wingdings" in font.name or "Webdings" in font.name):\par
            for c in run.text:\par
                html += wingdings_mapper(ord(c))\par
            continue\par
\par
        open_tags = []\par
\par
        if font.color and font.color.rgb:\par
            html += f'<FONT STYLE="color:\{rgb_to_hex(font.color.rgb)\};">'\par
            open_tags.append("</FONT>")\par
\par
        if font.size and font.size.pt not in (10, 12):\par
            html += f'<FONT STYLE="font-size:\{int(font.size.pt)\}pt;">'\par
            open_tags.append("</FONT>")\par
\par
        if font.bold:\par
            html += "<b>"\par
            open_tags.append("</b>")\par
        if font.italic:\par
            html += "<i>"\par
            open_tags.append("</i>")\par
        if font.underline:\par
            html += "<u>"\par
            open_tags.append("</u>")\par
\par
        html += txt\par
\par
        for tag in reversed(open_tags):\par
            html += tag\par
\par
    if not html.strip():\par
        return '<P STYLE="margin:0;">&nbsp;</P>'\par
\par
    return f'<P STYLE="font:12pt Times New Roman, Times, Serif; text-align:\{paragraph_alignment(para)\}; margin:0;">\{html\}</P>'\par
\par
# =====================================================\par
# TABLE CONVERSION\par
# =====================================================\par
\par
def table_to_html(table):\par
    html = '<table cellspacing="0" cellpadding="0" style="border-collapse:collapse;width:100%;">'\par
\par
    for row in table.rows:\par
        html += "<tr>"\par
        for cell in row.cells:\par
            cell_text = ""\par
            for p in cell.paragraphs:\par
                cell_text += convert_paragraph(p)\par
            html += f'<td style="border:1pt solid black;padding:2pt;">\{cell_text\}</td>'\par
        html += "</tr>"\par
    html += "</table>"\par
    return html\par
\par
# =====================================================\par
# IMAGE EXTRACTION\par
# =====================================================\par
\par
def extract_images(doc, out_dir, base):\par
    img_html = []\par
    img_idx = 1\par
\par
    for rel in doc.part.rels.values():\par
        if "image" in rel.reltype:\par
            img = rel.target_part.blob\par
            name = f"\{base\}x\{img_idx\}.jpg"\par
            path = os.path.join(out_dir, name)\par
\par
            with open(path, "wb") as f:\par
                f.write(img)\par
\par
            img_html.append(\par
                f'<P STYLE="margin:0;text-align:center;"><img src="\{name\}"></P>'\par
            )\par
            img_idx += 1\par
\par
    return img_html\par
\par
# =====================================================\par
# MAIN\par
# =====================================================\par
\par
def word_to_edgar(docx_path):\par
    doc = Document(docx_path)\par
    out_dir = os.path.dirname(docx_path)\par
    base = os.path.splitext(os.path.basename(docx_path))[0]\par
\par
    html = []\par
    html.append('<HTML><HEAD><TITLE></TITLE></HEAD>')\par
    html.append('<BODY STYLE="font:10pt Times New Roman, Times, Serif;">')\par
\par
    # Images\par
    html.extend(extract_images(doc, out_dir, base))\par
\par
    # Paragraphs & Tables\par
    for block in doc.element.body:\par
        if block.tag.endswith("p"):\par
            para = doc.paragraphs.pop(0)\par
            html.append(convert_paragraph(para))\par
\par
        elif block.tag.endswith("tbl"):\par
            table = doc.tables.pop(0)\par
            html.append(table_to_html(table))\par
\par
    html.append("</BODY></HTML>")\par
    return "\\n".join(html)\par
\par
