def build_package(html, xbrl_files, images_dir, out_dir):\par
    os.makedirs(out_dir, exist_ok=True)\par
    os.makedirs(os.path.join(out_dir, "images"), exist_ok=True)\par
\par
    shutil.copy(html, out_dir)\par
\par
    for f in xbrl_files:\par
        shutil.copy(f, out_dir)\par
\par
    for img in os.listdir(images_dir):\par
        shutil.copy(\par
            os.path.join(images_dir, img),\par
            os.path.join(out_dir, "images")\par
        )\par
\par
    with open(os.path.join(out_dir, "manifest.txt"), "w") as f:\par
        f.write("EDGAR PACKAGE READY\\n")\par
