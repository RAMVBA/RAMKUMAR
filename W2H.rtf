\f3\u9989?\f2  \f0 XBRL \f3\u8596?\f2  \f0 HTML CROSS-CHECK SCRIPT\par
import re\par
from lxml import etree\par
from bs4 import BeautifulSoup\par
\par
NUM_RE = re.compile(r"-?\\(?\\d\{1,3\}(?:,\\d\{3\})*(?:\\.\\d+)?\\)?")\par
\par
def extract_html_numbers(html):\par
    soup = BeautifulSoup(open(html, encoding="utf-8"), "html.parser")\par
    text = soup.get_text(" ")\par
    return set(NUM_RE.findall(text))\par
\par
def extract_xbrl_numbers(xbrl):\par
    tree = etree.parse(xbrl)\par
    nums = set()\par
    for elem in tree.iter():\par
        if elem.text and NUM_RE.search(elem.text):\par
            nums.add(elem.text.strip())\par
    return nums\par
\par
def reconcile_xbrl_html(html, xbrl):\par
    html_nums = extract_html_numbers(html)\par
    xbrl_nums = extract_xbrl_numbers(xbrl)\par
\par
    missing = xbrl_nums - html_nums\par
    extra = html_nums - xbrl_nums\par
\par
    return missing, extra\par
\par
\par
