\par
def rgb_to_hex(rgb):\par
    if not rgb:\par
        return ""\par
    return "#\{:02X\}\{:02X\}\{:02X\}".format(rgb[0], rgb[1], rgb[2])\par
\par
def escape_html(txt):\par
    html_map = \{\par
        "&": "&amp;", "<": "&lt;", ">": "&gt;",\par
        "\f2\bullet ": "&bull;", "\endash ": "&ndash;", "\emdash ": "&mdash;",\par
        "\f0\'a7": "&sect;", "\'a9": "&copy;", "\'ae": "&reg;",\par
        "\'e1": "&aacute;", "\'e0": "&agrave;", "\'e4": "&auml;",\par
        "\'e9": "&eacute;", "\'e8": "&egrave;", "\'eb": "&euml;",\par
        "\'ed": "&iacute;", "\'ec": "&igrave;", "\'ef": "&iuml;",\par
        "\'f3": "&oacute;", "\'f2": "&ograve;", "\'f6": "&ouml;",\par
        "\'fa": "&uacute;", "\'f9": "&ugrave;", "\'fc": "&uuml;",\par
        "\'f1": "&ntilde;", "\'e7": "&ccedil;",\par
        "\f6\u339?": "&oelig;", "\u338?": "&OElig;", "\f0\'df": "&szlig;"\par
    \}\par
    for k, v in html_map.items():\par
        txt = txt.replace(k, v)\par
    return txt\par
\par
def is_page_break(paragraph):\par
    return any(\par
        run._element.xpath(".//w:br[@w:type='page']")\par
        for run in paragraph.runs\par
    )\par
\par
def detect_financial_table(tbl):\par
    keywords = ["$", "revenue", "assets", "liabilities", "income"]\par
    text = " ".join(cell.text.lower() for row in tbl.rows for cell in row.cells)\par
    return any(k in text for k in keywords)\par
\par
# ======================================================\par
# IMAGE EXTRACTION (PAGE-AWARE)\par
# ======================================================\par
\par
def extract_images(doc, out_dir, base):\par
    images = []\par
    page = 1\par
    page_img_counter = \{\}\par
\par
    for rel in doc.part.rels.values():\par
        if "image" in rel.reltype:\par
            page_img_counter.setdefault(page, 0)\par
            page_img_counter[page] += 1\par
\par
            img_name = f"\{base\}x\{page\}x\{page_img_counter[page]\}.jpg"\par
            img_path = os.path.join(out_dir, img_name)\par
\par
            with open(img_path, "wb") as f:\par
                f.write(rel.target_part.blob)\par
\par
            images.append(\par
                f'<P STYLE="margin:0;text-align:center;"><img src="\{img_name\}"></P>'\par
            )\par
    return images\par
\par
# ======================================================\par
# PARAGRAPH\par
# ======================================================\par
\par
def convert_paragraph(p):\par
    html = ""\par
    for run in p.runs:\par
        if not run.text.strip():\par
            continue\par
\par
        txt = escape_html(run.text)\par
        f = run.font\par
        tags = []\par
\par
        if f.color and f.color.rgb:\par
            html += f'<FONT STYLE="color:\{rgb_to_hex(f.color.rgb)\};">'\par
            tags.append("</FONT>")\par
\par
        if f.size and f.size.pt not in (10, 12):\par
            html += f'<FONT STYLE="font-size:\{int(f.size.pt)\}pt;">'\par
            tags.append("</FONT>")\par
\par
        if f.bold:\par
            html += "<b>"; tags.append("</b>")\par
        if f.italic:\par
            html += "<i>"; tags.append("</i>")\par
        if f.underline:\par
            html += "<u>"; tags.append("</u>")\par
\par
        html += txt\par
\par
        for t in reversed(tags):\par
            html += t\par
\par
    return '<P STYLE="margin:0;">&nbsp;</P>' if not html else f'<P STYLE="margin:0;">\{html\}</P>'\par
\par
# ======================================================\par
# TABLE\par
# ======================================================\par
\par
def convert_table(tbl):\par
    financial = detect_financial_table(tbl)\par
    html = '<table cellspacing="0" cellpadding="0" style="border-collapse:collapse;width:100%;">'\par
\par
    for row in tbl.rows:\par
        html += "<tr>"\par
        for cell in row.cells:\par
            cell_html = ""\par
            for p in cell.paragraphs:\par
                cell_html += convert_paragraph(p)\par
\par
            border = "border:1pt solid black;" if financial else "border:none;"\par
            html += f'<td style="\{border\}padding:2pt;">\{cell_html\}</td>'\par
        html += "</tr>"\par
\par
    html += "</table>"\par
    return html\par
\par
# ======================================================\par
# CORE CONVERTER\par
# ======================================================\par
\par
def convert_doc(docx, out_dir):\par
    doc = Document(docx)\par
    base = os.path.splitext(os.path.basename(docx))[0]\par
\par
    html = []\par
    html.append('<HTML><HEAD><TITLE></TITLE></HEAD>')\par
    html.append('<BODY STYLE="font:10pt Times New Roman, Times, Serif;">')\par
\par
    page = 1\par
\par
    for block in doc.element.body:\par
        if block.tag.endswith("p"):\par
            p = doc.paragraphs.pop(0)\par
\par
            if is_page_break(p):\par
                html.append(\par
                    f'<!-- Field: Page; Sequence:\{page\} -->'\par
                    '<DIV STYLE="break-before:page;"></DIV>'\par
                    '<!-- Field: /Page -->'\par
                )\par
                page += 1\par
                continue\par
\par
            html.append(convert_paragraph(p))\par
\par
        elif block.tag.endswith("tbl"):\par
            tbl = doc.tables.pop(0)\par
            html.append(convert_table(tbl))\par
\par
    html.append("</BODY></HTML>")\par
\par
    with open(os.path.join(out_dir, base + ".htm"), "w", encoding="utf-8") as f:\par
        f.write("\\n".join(html))\par
\par
    extract_images(doc, out_dir, base)\par
\par
