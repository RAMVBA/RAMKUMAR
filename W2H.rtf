import fitz\par
\par
def annotate_pdf(pdf, issues, out_pdf):\par
    doc = fitz.open(pdf)\par
    for issue in issues:\par
        page = doc[issue["page"] - 1]\par
        rects = page.search_for(issue["text"])\par
        for r in rects:\par
            annot = page.add_highlight_annot(r)\par
            annot.set_info(content=issue["comment"])\par
            annot.update()\par
    doc.save(out_pdf)\par
