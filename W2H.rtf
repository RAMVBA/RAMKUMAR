import fitz  # PyMuPDF\par
from bs4 import BeautifulSoup\par
import re\par
\par
# ----------------------------------\par
# NORMALIZATION\par
# ----------------------------------\par
\par
def normalize(t):\par
    t = t.lower()\par
    t = re.sub(r"\\s+", " ", t)\par
    t = t.replace("&nbsp;", " ")\par
    return t.strip()\par
\par
# ----------------------------------\par
# PDF TEXT\par
# ----------------------------------\par
\par
def extract_pdf_text(pdf_path):\par
    doc = fitz.open(pdf_path)\par
