def sec_preflight(html_file):\par
    errors = []\par
\par
    with open(html_file, encoding="utf-8") as f:\par
        html = f.read().lower()\par
\par
    if "<html" not in html or "<body" not in html:\par
        errors.append("Missing <HTML>/<BODY>")\par
\par
    for tag in FORBIDDEN:\par
        if tag in html:\par
            errors.append(f"Forbidden tag found: \{tag\}")\par
\par
    pages = re.findall(r"field:\\s*page;\\s*sequence:(\\d+)", html)\par
    if pages != list(map(str, range(1, len(pages) + 1))):\par
        errors.append("Page sequence broken")\par
\par
    return errors\par
