\par
def rgb_to_hex(rgb):\par
    if rgb is None:\par
        return ""\par
    return "#\{:02X\}\{:02X\}\{:02X\}".format(rgb[0], rgb[1], rgb[2])\par
\par
def escape_entities(text):\par
    """Match VBA Replace logic for EDGAR"""\par
    replacements = \{\par
        "&": "&amp;",\par
        "<": "&lt;",\par
        ">": "&gt;",\par
        "\f2\bullet ": "&bull;",\par
        "\endash ": "&ndash;",\par
        "\emdash ": "&mdash;",\par
        "\f0\'a7": "&sect;",\par
        "\'a9": "&copy;",\par
        "\'ae": "&reg;",\par
        "\'b5": "&micro;",\par
        "\'e1": "&aacute;", "\'e0": "&agrave;", "\'e2": "&acirc;", "\'e4": "&auml;",\par
        "\'e9": "&eacute;", "\'e8": "&egrave;", "\'ea": "&ecirc;", "\'eb": "&euml;",\par
        "\'ed": "&iacute;", "\'ec": "&igrave;", "\'ee": "&icirc;", "\'ef": "&iuml;",\par
        "\'f3": "&oacute;", "\'f2": "&ograve;", "\'f4": "&ocirc;", "\'f6": "&ouml;",\par
        "\'fa": "&uacute;", "\'f9": "&ugrave;", "\'fb": "&ucirc;", "\'fc": "&uuml;",\par
        "\'f1": "&ntilde;", "\'e7": "&ccedil;",\par
        "\f6\u339?": "&oelig;", "\u338?": "&OElig;",\par
        "\f0\'df": "&szlig;"\par
    \}\par
    for k, v in replacements.items():\par
        text = text.replace(k, v)\par
    return text\par
\par
def wingdings_mapper(char_code):\par
    """Stub \f2\endash  extend as per your VBA ReplaceWingdingsSymbol"""\par
    mapping = \{\par
        252: "&check;",\par
        168: "&bull;"\par
    \}\par
    return mapping.get(char_code, "")\par
\par
# -----------------------------\par
# Core Conversion Logic\par
# -----------------------------\par
\par
def convert_word_to_html(docx_path):\par
    doc = Document(docx_path)\par
    html_out = []\par
\par
    html_out.append('<HTML><HEAD><TITLE></TITLE></HEAD>')\par
    html_out.append('<BODY STYLE="font:10pt Times New Roman, Times, Serif;">')\par
\par
    for para in doc.paragraphs:\par
        html_line = ""\par
        open_tags = \{\par
            "b": False,\par
            "i": False,\par
            "u": False,\par
            "font": False\par
        \}\par
\par
        for run in para.runs:\par
            text = run.text\par
            if not text.strip():\par
                continue\par
\par
            text = escape_entities(text)\par
\par
            font = run.font\par
            font_name = font.name or ""\par
            font_size = font.size.pt if font.size else None\par
            font_color = rgb_to_hex(font.color.rgb)\par
\par
            # Wingdings handling\par
            if "Wingdings" in font_name or "Webdings" in font_name:\par
                for ch in run.text:\par
                    html_line += wingdings_mapper(ord(ch))\par
                continue\par
\par
            # Font color\par
            if font_color:\par
                html_line += f'<FONT STYLE="color:\{font_color\};">'\par
                open_tags["font"] = True\par
\par
            # Font size\par
            if font_size and font_size not in (10, 12):\par
                html_line += f'<FONT STYLE="font-size:\{int(font_size)\}pt;">'\par
                open_tags["font"] = True\par
\par
            # Bold / Italic / Underline\par
            if font.bold:\par
                html_line += "<b>"\par
                open_tags["b"] = True\par
            if font.italic:\par
                html_line += "<i>"\par
                open_tags["i"] = True\par
            if font.underline:\par
                html_line += "<u>"\par
                open_tags["u"] = True\par
\par
            html_line += text\par
\par
            # Close tags\par
            if open_tags["u"]:\par
                html_line += "</u>"\par
                open_tags["u"] = False\par
            if open_tags["i"]:\par
                html_line += "</i>"\par
                open_tags["i"] = False\par
            if open_tags["b"]:\par
                html_line += "</b>"\par
                open_tags["b"] = False\par
            if open_tags["font"]:\par
                html_line += "</FONT>"\par
                open_tags["font"] = False\par
\par
        if not html_line.strip():\par
            html_out.append('<P STYLE="margin:0;">&nbsp;</P>')\par
        else:\par
            html_out.append(\par
                '<P STYLE="font:12pt Times New Roman, Times, Serif; margin:0;">'\par
                + html_line +\par
                '</P>'\par
            )\par
\par
    html_out.append("</BODY></HTML>")\par
    return "\\n".join(html_out)\par
\par
