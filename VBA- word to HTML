Private Function GetCellBorderStyle(cel As Cell) As String

    Dim s As String

    Dim b As Border

    Dim colorHex As String

    Dim lineWidth As String

    Dim lineStyle As String

    Dim side As Variant

    Dim sides As Variant

   

    sides = Array(wdBorderTop, wdBorderBottom, wdBorderLeft, wdBorderRight)

   

    For Each side In sides

        Set b = cel.Borders(side)

        If b.lineStyle <> wdLineStyleNone Then

           

            ' Get width

            Select Case b.lineWidth

                Case wdLineWidth025pt: lineWidth = "0.25pt"

                Case wdLineWidth050pt: lineWidth = "0.5pt"

                Case wdLineWidth075pt: lineWidth = "0.75pt"

                Case wdLineWidth100pt: lineWidth = "1pt"

                Case wdLineWidth150pt: lineWidth = "1.5pt"

                Case wdLineWidth225pt: lineWidth = "2.25pt"

                Case wdLineWidth300pt: lineWidth = "3pt"

                Case Else: lineWidth = "1pt"

            End Select

           

            ' Get line style

            Select Case b.lineStyle

                Case wdLineStyleSingle: lineStyle = "solid"

                Case wdLineStyleDouble: lineStyle = "double"

                Case Else: lineStyle = "solid"

            End Select

           

            ' Get color (skip Auto or Black)

            colorHex = RGBToHex(b.Color)

            If colorHex = "#000000" Or colorHex = "#00000000" Then

                colorHex = "Black"

            End If

           

            ' Build style per side

            Select Case side

                Case wdBorderTop

                    s = s & "border-top:" & colorHex & " " & lineWidth & " " & lineStyle

                Case wdBorderBottom

                    s = s & "border-bottom:" & colorHex & " " & lineWidth & " " & lineStyle

                Case wdBorderLeft

                    s = s & "border-left:" & colorHex & " " & lineWidth & " " & lineStyle

                Case wdBorderRight

                    s = s & "border-right:" & colorHex & " " & lineWidth & " " & lineStyle

            End Select

        End If

    Next side

 

   

    GetCellBorderStyle = Trim(s)

   

End Function

 

