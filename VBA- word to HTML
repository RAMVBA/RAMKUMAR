' === Find where to split: scan left ? right, stop before first ")" ===

Function FindSplitPosition(txt As String) As Long

    Dim i As Long, ch As String

    txt = Trim(txt)

    FindSplitPosition = 0

   

    ' 1. Find first closing parenthesis and split before it

    For i = 1 To Len(txt)

        ch = Mid(txt, i, 1)

        If ch = ")" Then

            FindSplitPosition = i     ' split immediately BEFORE ")"

            Exit Function

        End If

    Next i

   

    ' 2. If no ")", look for percent or other symbols

    For i = 1 To Len(txt)

        ch = Mid(txt, i, 1)

        If ch = "%" Or ch = "]" Or ch = "}" Then

            FindSplitPosition = i

            Exit Function

        End If

    Next i

End Function

 

' === Enhanced SplitCurrencyValueSymbols (handles %) and ")%" ===

Function SplitCurrencyValueSymbols(txt As String, ByRef curPart As String, ByRef valPart As String, ByRef rightPart As String)

    Dim temp As String, splitPos As Long

    Dim htmlcur As String, beforeTag As String, afterTag As String, innerText As String, found As String, PreserveTag As String

 

    txt = Trim(txt)

   

    curPart = "&nbsp;"

    valPart = ""

    rightPart = "&nbsp;"

   

    '------------------

    Dim p1 As Long, p2 As Long

   

    Do While Left(txt, 1) = "<"

        p2 = InStr(1, txt, ">")

        If p2 = 0 Then Exit Do

 

        beforeTag = beforeTag & Left(txt, p2)

        txt = Mid(txt, p2 + 1)

        txt = LTrim(txt)

    Loop

   

    '-------------------------

   

      Do While Right(txt, 1) = ">"

        p1 = InStrRev(txt, "<")

        If p1 = 0 Then Exit Do

 

        afterTag = Mid(txt, p1) & afterTag

        txt = Left(txt, p1 - 1)

        txt = RTrim(txt)

    Loop

   

    'Extract opening <font ...> tag

    'beforeTag = CutTagFromText(txt)

   

    'Extract closing </font> tag

    'afterTag = Right(txt, Len(txt) - InStrRev(txt, "<") + 1)

   

    'Extract inner text only

    'txt = Mid(txt, InStr(1, txt, ">") + 1, _

                    InStrRev(txt, "<") - InStr(1, txt, ">") - 1)

    'txt = Right(txt, Len(txt) - Len(beforeTag))

   

    txt = Replace(txt, beforeTag, "", 1, 1)

   

    ' --- 1. Normalize leading currency signs ---

    If Left(txt, 2) = "-$" Then

        curPart = "$"

        temp = "-" & Mid(txt, 3)

    ElseIf Left(txt, 2) = "($" Then

        curPart = "$"

        temp = "(" & Mid(txt, 3)

    ElseIf Left(txt, 1) = "$" Then

        curPart = "$"

        temp = Mid(txt, 2)

    ElseIf Left(txt, 1) = "(" And Mid(txt, 2, 1) = "$" Then

        curPart = "$"

        temp = "(" & Mid(txt, 3)

    ElseIf Left(txt, 1) = "-" And Mid(txt, 2, 1) = "$" Then

        curPart = "$"

        temp = "-" & Mid(txt, 3)

    Else

        temp = txt

    End If

   

    temp = Trim(temp)

   

    ' --- 2. Find split point (before first closing parenthesis) ---

    splitPos = FindSplitPosition(temp)

   

    ' --- Special fix: if pattern like (1,234%) ? split before ")"

    ' but keep % attached to rightPart as ")%"

    If splitPos > 0 Then

        ' If previous character (left of split) is "%", move it into rightPart

        If Mid(temp, splitPos - 1, 1) = "%" Then

            valPart = Left(temp, splitPos - 2)

            rightPart = Mid(temp, splitPos - 1)  ' includes %)

        Else

            valPart = Left(temp, splitPos - 1)

            rightPart = Mid(temp, splitPos)

        End If

    Else

        valPart = temp

        rightPart = "&nbsp;"

    End If

   

    valPart = Trim(valPart)

    rightPart = Trim(rightPart)

   

    ' --- 3. Handle currency sign inside value ---

    If Left(valPart, 1) = "$" Then

        valPart = Mid(valPart, 2)

        curPart = "$"

    End If

   

    ' --- 4. Adjust if rightPart starts with "%)" ? reorder to ")%" ---

    If Left(rightPart, 2) = "%)" Then rightPart = ")%"

   

    ' --- 5. Cleanup ---

    If valPart = "" Then valPart = "&nbsp;"

    If rightPart = "" Then rightPart = "&nbsp;"

   

    curPart = beforeTag & Trim(curPart)

    valPart = beforeTag & Trim(valPart)

    rightPart = beforeTag & Trim(rightPart)

   

    SplitCurrencyValueSymbols = htmlcur

   

End Function

 

