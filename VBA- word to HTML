Function GetCellColspan(tbl As Word.Table, r As Long, c As Long) As Long

    Dim curCol As Long, nextCol As Long

   

    ' Current cell's internal column index

    curCol = tbl.Cell(r, c).ColumnIndex

   

    ' If this is the last cell of the row ? colspan = 1

    If c = tbl.rows(r).Cells.count Then

        GetCellColspan = 1

        Exit Function

    End If

 

    ' Next cell's internal column index

    nextCol = tbl.Cell(r, c + 1).ColumnIndex

   

    ' Colspan is difference

    GetCellColspan = nextCol - curCol

End Function

Function CutTagFromText(txt As String) As String

 

    Dim s As String, p1 As Long, p2 As Long, outTag As String

 

    s = txt

 

    ' Find start and end of <...>

    p1 = InStr(s, "<")

    p2 = InStr(p1 + 1, s, ">")

 

    If p1 > 0 And p2 > 0 Then

        outTag = Mid$(s, p1, p2 - p1 + 1)   ' Extract tag

        s = Left$(s, p1 - 1) & Mid$(s, p2 + 1) ' Remove it

    Else

        outTag = ""                         ' No tag found

    End If

 

    CutTagFromText = outTag

   

 

End Function

 

