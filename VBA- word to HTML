'=== Convert Word color (Long) to #RRGGBB ===

Function GetColorHex(wordColor As Long) As String

    Dim r As Long, g As Long, b As Long

    If wordColor = wdColorAutomatic Or wordColor = 0 Then

        GetColorHex = "#000000"

        Exit Function

    End If

    r = wordColor Mod 256

    g = (wordColor \ 256) Mod 256

    b = (wordColor \ 65536) Mod 256

    GetColorHex = "#" & Right("0" & Hex(r), 2) & Right("0" & Hex(g), 2) & Right("0" & Hex(b), 2)

End Function

Function GetColumnNumberFromSelection() As Long

