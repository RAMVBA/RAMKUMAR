Function GetEdgarHeaderRowCount(tbl As Table) As Long

   

    Dim r As Long, c As Long

    Dim txt As String

    Dim isHeader As Boolean

    Dim hasNumber As Boolean

    Dim headerRows As Long

   

    headerRows = 0

   

    For r = 1 To tbl.rows.count

       

        isHeader = False

        hasNumber = False

       

        ' ---------------------------------------

        ' Step 1: Detect if row contains numbers

        ' ---------------------------------------

        For c = 1 To tbl.rows(r).Cells.count

           

            txt = CleanCellText(tbl.rows(r).Cells(c).Range.Text)

           

            If txt Like "*#,#*" Or _

               txt Like "*(#,#)*" Or _

               txt Like "*.#*" Or _

               IsNumeric(txt) Then

              

                hasNumber = True

                Exit For

            End If

        Next c

       

        ' First numeric row ? data row ? STOP

        If hasNumber Then Exit For

       

        

        ' ---------------------------------------

        ' Step 2: Apply EDGAR header rules

        ' ---------------------------------------

        If RowIsBlank(tbl, r) _

        Or RowHasDate(tbl, r) _

        Or RowHasUnits(tbl, r) _

        Or RowHasYearOnly(tbl, r) _

        Or RowHasAuditStatus(tbl, r) _

        Or RowIsTextOnly(tbl, r) _

        Or RowIsCentered(tbl, r) _

        Or RowIsBoldText(tbl, r) Then

       

            isHeader = True

        End If

       

        ' Not header ? STOP LOOP

        If Not isHeader Then Exit For

       

        headerRows = headerRows + 1

    Next r

   

    GetEdgarHeaderRowCount = headerRows

End Function

Function RowIsBlank(tbl As Table, r As Long) As Boolean

    Dim c As Long

    For c = 1 To tbl.rows(r).Cells.count

        If CleanCellText(tbl.rows(r).Cells(c).Range.Text) <> "" Then

            RowIsBlank = False: Exit Function

        End If

    Next

    RowIsBlank = True

End Function

Function RowHasDate(tbl As Table, r As Long) As Boolean

    Dim m As String, c As Long, t As String

    For c = 1 To tbl.rows(r).Cells.count

        t = LCase(CleanCellText(tbl.rows(r).Cells(c).Range.Text))

        If t Like "*january*" Or t Like "*feb*" Or t Like "*mar*" Or _

           t Like "*apr*" Or t Like "*may*" Or t Like "*jun*" Or _

           t Like "*jul*" Or t Like "*aug*" Or t Like "*sep*" Or _

           t Like "*oct*" Or t Like "*nov*" Or t Like "*dec*" Or _

           InStr(t, "ended") > 0 Then

           RowHasDate = True: Exit Function

        End If

    Next

End Function

Function RowHasUnits(tbl As Table, r As Long) As Boolean

    Dim c As Long, t As String

    For c = 1 To tbl.rows(r).Cells.count

        t = LCase(CleanCellText(tbl.rows(r).Cells(c).Range.Text))

        If InStr(t, "thousand") > 0 Or InStr(t, "million") > 0 Or _

           InStr(t, "share") > 0 Or InStr(t, "per share") > 0 Then

           RowHasUnits = True: Exit Function

        End If

    Next

End Function

Function RowHasYearOnly(tbl As Table, r As Long) As Boolean

    Dim c As Long, t As String

    For c = 1 To tbl.rows(r).Cells.count

        t = CleanCellText(tbl.rows(r).Cells(c).Range.Text)

        If t Like "20##" Then

            RowHasYearOnly = True: Exit Function

        End If

    Next

End Function

Function RowHasAuditStatus(tbl As Table, r As Long) As Boolean

    Dim c As Long, t As String

    For c = 1 To tbl.rows(r).Cells.count

        t = LCase(CleanCellText(tbl.rows(r).Cells(c).Range.Text))

        If InStr(t, "audited") > 0 Or InStr(t, "unaudited") > 0 Then

            RowHasAuditStatus = True: Exit Function

        End If

    Next

End Function

Function RowIsTextOnly(tbl As Table, r As Long) As Boolean

    Dim c As Long, t As String

    For c = 1 To tbl.rows(r).Cells.count

        t = CleanCellText(tbl.rows(r).Cells(c).Range.Text)

        If IsNumeric(t) Or t Like "*#,#*" Or t Like "*#.#*" Then

            RowIsTextOnly = False: Exit Function

        End If

    Next

    RowIsTextOnly = True

End Function

Function RowIsCentered(tbl As Table, r As Long) As Boolean

    RowIsCentered = (tbl.rows(r).Cells(1).Range.ParagraphFormat.Alignment = wdAlignParagraphCenter)

End Function

Function RowIsBoldText(tbl As Table, r As Long) As Boolean

    RowIsBoldText = (tbl.rows(r).Range.Font.Bold = True)

End Function

 

Function DetectHeaderRows(tbl As Table) As Long

 

    Dim r As Long, c As Long

    Dim txt As String, low As String

    Dim maxHeaderRow As Long

    Dim stopRow As Long

   

    maxHeaderRow = 0

    stopRow = 0

   

    ' ====================================================

    ' Scan entire table for header indicators and stop cues

    ' ====================================================

    For r = 1 To tbl.rows.count

        For c = 1 To tbl.rows(r).Cells.count

       

            txt = CleanCellText(tbl.rows(r).Cells(c).Range.Text)

            low = LCase(txt)

           

            If low = Chr(160) Then GoTo skipcell:

                       

            ' ====================================================

            '                 HEADER DETECTION RULES

            ' ====================================================

           

            

            ' ---------- Rule 1: Month names ----------

            If low Like "*jan*" Or low Like "*feb*" Or low Like "*mar*" Or _

               low Like "*apr*" Or low Like "*may*" Or low Like "*jun*" Or _

               low Like "*jul*" Or low Like "*aug*" Or low Like "*sep*" Or _

               low Like "*oct*" Or low Like "*nov*" Or low Like "*dec*" Then

              

               If r > maxHeaderRow Then maxHeaderRow = r

            End If

           

            ' ---------- Rule 2: Month + day date headers ----------

            If (low Like "*jan* ##*" Or low Like "*feb* ##*" Or _

                low Like "*mar* ##*" Or low Like "*apr* ##*" Or _

                low Like "*may* ##*" Or low Like "*jun* ##*" Or _

                low Like "*jul* ##*" Or low Like "*aug* ##*" Or _

                low Like "*sep* ##*" Or low Like "*oct* ##*" Or _

                low Like "*nov* ##*" Or low Like "*dec* ##*") Then

               

                If r > maxHeaderRow Then maxHeaderRow = r

            End If

           

            ' ---------- Rule 3: Year headers (2024, 2025) ----------

            If txt Like "20##" Or txt Like "(20##)" Then

                If r > maxHeaderRow Then maxHeaderRow = r

            End If

           

            ' ---------- Rule 4: Audit status ----------

            If InStr(low, "audited") > 0 Or InStr(low, "unaudited") > 0 Then

                If r > maxHeaderRow Then maxHeaderRow = r

            End If

           

            ' ---------- Rule 5: Units ----------

            If InStr(low, "thousand") > 0 Or _

               InStr(low, "million") > 0 Or _

               InStr(low, "except") > 0 Or _

               InStr(low, "per share") > 0 Then

              

               If r > maxHeaderRow Then maxHeaderRow = r

            End If

           

            ' ---------- Rule 6: Financial captions ----------

            If InStr(low, "amount") > 0 Or _

               InStr(low, "% of total") > 0 Or _

               InStr(low, "fair value") > 0 Or _

               InStr(low, "unrealized") > 0 Or _

               InStr(low, "gain") > 0 Or _

               InStr(low, "loss") > 0 Or _

               InStr(low, "amortized") > 0 Or _

               InStr(low, "cost") > 0 Or _

               InStr(low, "shares") > 0 Or _

               InStr(low, "capital") > 0 Or _

               InStr(low, "income (loss)") > 0 Then

              

               If r > maxHeaderRow Then maxHeaderRow = r

            End If

           

            ' ---------- Rule 7: Equity captions ----------

            If InStr(low, "common stock") > 0 Or _

               InStr(low, "preferred stock") > 0 Or _

               InStr(low, "additional paid-in") > 0 Or _

               InStr(low, "accumulated other comprehensive") > 0 Or _

               InStr(low, "retained earnings") > 0 Then

              

               If r > maxHeaderRow Then maxHeaderRow = r

            End If

       

        ' ====================================================

            '                STOP CONDITIONS

            '  (Data begins ? stop scanning)

            ' ====================================================

           

            ' ---------- STOP 1: Financial section names ----------

            If low Like "*asset*" Or low Like "*liabilit*" Or _

               low Like "*equity*" Or low Like "*revenue*" Or _

               low Like "*expense*" Or low Like "*income*" Or _

               low Like "*cash*" Or low Like "*operations*" Then

              

               stopRow = r

               If r = maxHeaderRow And maxHeaderRow > 0 Then maxHeaderRow = stopRow

               GoTo Finalize

            End If

           

            ' ---------- STOP 2: $ with comma number ----------

            If low Like "*$#,*" Or low Like "*$ #,*" Or _

               low Like "*$(#,#)*" Or low Like "*$(*" Then

              

               stopRow = r

               If r = maxHeaderRow And maxHeaderRow > 0 Then maxHeaderRow = maxHeaderRow - 1

               GoTo Finalize

            End If

           

            ' ---------- STOP 3: numeric data rows WITH comma ----------

            If txt Like "*#,#*" Or txt Like "*(#,#)*" Then

               stopRow = r

               If r = maxHeaderRow And maxHeaderRow > 0 Then maxHeaderRow = maxHeaderRow - 1

               GoTo Finalize

            End If

       

skipcell:

        Next c

    Next r

   

    

Finalize:

 

    ' ====================================================

    ' EDGE-CASE FIXES

    ' ====================================================

   

    ' ---- Rule: If header not detected but stopRow=2 ? header = 1

    If maxHeaderRow = 0 And stopRow = 2 Then

        maxHeaderRow = 1

    End If

   

    ' ---- Never allow negative

    If maxHeaderRow < 0 Then maxHeaderRow = 0

   

    DetectHeaderRows = maxHeaderRow

 

End Function

 

