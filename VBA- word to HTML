Function IsFinancialText(txt As String) As Boolean

    Dim RE As Object

    Set RE = CreateObject("VBScript.RegExp")

   

    RE.Pattern = "(\$?\(?\d{1,3}(,\d{3})+(\.\d+)?\)?%?)|(\$?\(?\d+\.\d+\)?%?)|(\$+\d+)"

    RE.IgnoreCase = True

    RE.Global = False

   

    IsFinancialText = RE.Test(txt)

End Function

 

Function CleanCellText(t As String) As String

    CleanCellText = Replace(t, Chr(13) & Chr(7), "")

End Function

 

Function GetAutoWidth(txt As String, Optional extraChars As Long = 0) As String

    'Estimate width based on characters and add extra space if needed.

    '1ch ˜ 0.6% of table width (adjust if needed)

   

    Dim base As Double

    base = Len(txt) * 0.6

   

    If extraChars > 0 Then

        base = base + (extraChars * 0.6)

    End If

   

    'Prevent too small or too large values

    If base < 1 Then base = 1

    If base > 30 Then base = 30

   

    GetAutoWidth = Format(base, "0") & "%"

End Function

 

