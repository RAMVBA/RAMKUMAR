'---------------------------------------------

' Function : ConvertSpaceIndent

' Purpose  : Adjusts indentation in table cells based on

'             spaces or parentheses spacing patterns.

' Usage    : Call ConvertSpaceIndent(tbl)

'---------------------------------------------

Public Function ConvertSpaceIndent(tbl As Object)

 

    Dim r As Long

    Dim tmpRng As Range

    Dim txt As String

    Dim spaceCount As Long

    Dim indentInches As Double

   

    On Error Resume Next

    Application.ScreenUpdating = False

 

    '--- Loop through all rows in table

    For r = 1 To tbl.rows.count

        Set tmpRng = tbl.Cell(r, 1).Range

        tmpRng.End = tmpRng.End - 1  ' remove end-of-cell marker

       

        '--- Get cell text

        txt = tmpRng.Text

       

        '--- Case 1: Pattern like "( )" or "(  )" etc

        If txt Like "(*@)" Or InStr(txt, Chr(160)) > 0 Then

            spaceCount = Len(txt) - Len(Replace(txt, Chr(160), ""))

           

            If spaceCount > 1 Then

                indentInches = 0.04 * spaceCount

                tmpRng.ParagraphFormat.LeftIndent = InchesToPoints(indentInches)

            End If

        End If

       

        '--- Case 2: Two or more regular spaces

        If InStr(txt, "  ") > 0 Then

            spaceCount = Len(txt) - Len(Replace(txt, " ", ""))

           

            If spaceCount > 1 Then

                indentInches = 0.04 * spaceCount

                tmpRng.ParagraphFormat.LeftIndent = InchesToPoints(indentInches)

            End If

        End If

    Next r

 

    '--- Now clean up patterns from table

    With tbl.Range.Find

        '.Text = "(" & Chr(160) & ")@"

        .Text = "Chr(160){2,}"

        .MatchWildcards = True

        .Replacement.Text = "Chr(160)"

        .Wrap = wdFindStop

        .Execute Replace:=wdReplaceAll

        .MatchWildcards = False

    End With

 

    With tbl.Range.Find

        .Text = "^32{2,}"

        .MatchWildcards = True

        .Replacement.Text = ""

        .Wrap = wdFindStop

        .Execute Replace:=wdReplaceAll

        .MatchWildcards = False

    End With

 

    Application.ScreenUpdating = True

    On Error GoTo 0

 

End Function

 

