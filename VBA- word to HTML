Function SaveImageAndGetHTML1(iSh As InlineShape) As String

    Dim fileName As String, imgCount As String, savePath As String

    Dim fullPath As String

    Dim w As Single, h As Single

    Dim html As String

   

    'Create image name

    fileName = "img_" & Format(imgCount, "000") & ".jpg"

    fullPath = savePath & "\" & fileName

 

    'Export the image

'    ish.Select

    Selection.CopyAsPicture

   

    ' Paste into a temp document

    Dim tempDoc As Document

    Set tempDoc = Documents.Add

    tempDoc.Content.Paste

 

    ' Save shape as JPG

    tempDoc.SaveAs2 fullPath, FileFormat:=wdFormatDocument

    tempDoc.Close SaveChanges:=False

 

    ' Image dimensions in points

    w = iSh.width

    h = iSh.Height

 

    ' Build <img> HTML

    html = "<img src=""" & fileName & """ style=""width:" & Format(w, "0") _

           & "pt; height:" & Format(h, "0") & "pt"">"

 

    SaveImageAndGetHTML = html

End Function

 

